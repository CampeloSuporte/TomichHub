<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc" xmlns:xi="http://www.w3.org/2001/XInclude">
  <applications>
    <!-- Só a janela principal ocupa a área inteira: diálogos e NE Manager do
         UNM2000 precisam da própria borda para fechar e mover. O type separa a
         principal dos avisos, que também têm o título "UNM2000". -->
    <application title="UNM2000*" type="normal">
      <decor>no</decor>
      <maximized>true</maximized>
    </application>
  </applications>
</openbox_config>
