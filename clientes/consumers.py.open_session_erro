import json
import paramiko
import telnetlib
import threading
import ipaddress
import logging
import time
import socket
from channels.generic.websocket import WebsocketConsumer
from .models import Acesso, ProxyServer
logger = logging.getLogger(__name__)
# ✅ NOVO: Configurar SSH com melhor performance
paramiko.util.log_to_file('/tmp/paramiko-debug.log', level=logging.DEBUG)
class SSHConsumer(WebsocketConsumer):
    def connect(self):
        self.accept()
        self.ssh_client = None
        self.telnet_client = None
        self.channel = None
        self.proxy_client = None
        self.proxy_channel = None  # ✅ NOVO: Rastrear proxy_channel
        self.read_thread = None
        self.protocol = None  # 'ssh' ou 'telnet'
        self.stop_reading = False  # ✅ NOVO: Flag para parar thread de leitura
    def disconnect(self, close_code):
        # ✅ MELHORADO: Parar thread de leitura PRIMEIRO
        self.stop_reading = True
        time.sleep(0.1)  # Dar tempo para a thread parar
        if self.channel:
            try:
                self.channel.close()
            except:
                pass
        if self.ssh_client:
            try:
                self.ssh_client.close()
            except:
                pass
        if self.telnet_client:
            try:
                self.telnet_client.close()
            except:
                pass
        # ✅ NOVO: Fechar proxy_channel ANTES do proxy_client
        if self.proxy_channel:
            try:
                self.proxy_channel.close()
            except:
                pass
        if self.proxy_client:
            try:
                self.proxy_client.close()
            except:
                pass
    def receive(self, text_data):
        data = json.loads(text_data)
        action = data.get('action')
        if action == 'connect':
            acesso_id = data.get('acesso_id')
            try:
                acesso = Acesso.objects.get(id=acesso_id)
                protocol = self.detect_protocol(acesso.porta)
                self.protocol = protocol
                self.stop_reading = False  # ✅ NOVO: Reset da flag
                logger.info(f"🔗 Usando protocolo: {protocol.upper()}")
                if self.is_private_ip(acesso.host):
                    if protocol == 'ssh':
                        self.connect_ssh_via_proxy(
                            acesso=acesso,
                            host=acesso.host,
                            port=int(acesso.porta),
                            username=acesso.usuario,
                            password=acesso.senha
                        )
                    else:
                        self.connect_telnet_via_proxy(
                            acesso=acesso,
                            host=acesso.host,
                            port=int(acesso.porta),
                            username=acesso.usuario,
                            password=acesso.senha
                        )
                else:
                    if protocol == 'ssh':
                        self.connect_ssh(
                            host=acesso.host,
                            port=int(acesso.porta),
                            username=acesso.usuario,
                            password=acesso.senha
                        )
                    else:
                        self.connect_telnet(
                            host=acesso.host,
                            port=int(acesso.porta),
                            username=acesso.usuario,
                            password=acesso.senha
                        )
            except Acesso.DoesNotExist:
                self.send(text_data=json.dumps({
                    'type': 'error',
                    'message': 'Acesso não encontrado'
                }))
            except Exception as e:
                logger.error(f"❌ Erro ao conectar: {str(e)}", exc_info=True)
                self.send(text_data=json.dumps({
                    'type': 'error',
                    'message': f'Erro ao conectar: {str(e)}'
                }))
        elif action == 'command':
            command = data.get('command', '')
            if self.protocol == 'ssh':
                if self.channel:
                    try:
                        self.channel.send(command)
                    except Exception as e:
                        logger.error(f"❌ Erro ao enviar comando SSH: {str(e)}")
            elif self.protocol == 'telnet':
                if self.telnet_client:
                    try:
                        self.telnet_client.write(command.encode('utf-8'))
                    except Exception as e:
                        logger.error(f"❌ Erro ao enviar comando Telnet: {str(e)}")
    def is_private_ip(self, host):
        """Verifica se o host é um IP privado"""
        try:
            ip = ipaddress.ip_address(host)
            return ip.is_private
        except ValueError:
            return False
    def detect_protocol(self, porta):
        """Detectar protocolo baseado na porta"""
        porta_int = int(porta)
        if porta_int == 22:
            return 'ssh'
        elif porta_int == 23:
            return 'telnet'
        elif porta_int in [2222, 8022, 10022, 9022]:
            return 'ssh'
        elif porta_int in [2323, 9023]:
            return 'telnet'
        else:
            return 'telnet' if porta_int < 1024 else 'ssh'
    def get_active_proxy(self, cliente):
        """Retorna um proxy ativo do cliente específico"""
        try:
            proxy = ProxyServer.objects.filter(
                cliente=cliente,
                ativo=True
            ).first()
            if not proxy:
                raise Exception(f"Nenhum servidor proxy ativo disponível para o cliente {cliente.nome_empresa}")
            return proxy
        except Exception as e:
            raise Exception(f"Erro ao buscar proxy: {str(e)}")
    # ============================================================
    # SSH - DIRECT
    # ============================================================
    def connect_ssh(self, host, port, username, password):
        """Conexão SSH direta (IP público)"""
        try:
            self.ssh_client = paramiko.SSHClient()
            self.ssh_client.set_missing_host_key_policy(paramiko.AutoAddPolicy())
            logger.info(f"🔗 SSH: Conectando a {host}:{port}")
            # ✅ MELHORADO: Adicionar keep_alive_interval
            self.ssh_client.connect(
                hostname=host,
                port=port,
                username=username,
                password=password,
                timeout=15,
                look_for_keys=False,
                allow_agent=False,
                banner_timeout=15
            )
            # ✅ NOVO: Configurar keep-alive no transport
            transport = self.ssh_client.get_transport()
            if transport:
                transport.set_keepalive(30)
            logger.info(f"✅ SSH: Conectado")
            channel = ssh_client.open_session()
            channel.get_pty()
            channel.invoke_shell()
            self.channel = channel
            # ✅ NOVO: Configurar channel como non-blocking
            self.channel.settimeout(0.5)
            self.send(text_data=json.dumps({
                'type': 'connected',
                'message': f'✓ Conectado SSH a {host}:{port}'
            }))
            self.read_thread = threading.Thread(target=self.read_ssh_output, daemon=True)
            self.read_thread.start()
        except paramiko.AuthenticationException:
            logger.error(f"❌ SSH: Erro de autenticação")
            self.send(text_data=json.dumps({
                'type': 'error',
                'message': 'Erro de autenticação SSH. Verifique usuário e senha.'
            }))
        except Exception as e:
            logger.error(f"❌ SSH: Erro ao conectar: {str(e)}", exc_info=True)
            self.send(text_data=json.dumps({
                'type': 'error',
                'message': f'Erro SSH: {str(e)}'
            }))
    # ============================================================
    # SSH - VIA PROXY (CORRIGIDO PARA EVITAR SEGFAULT)
    # ============================================================
    def connect_ssh_via_proxy(self, acesso, host, port, username, password):
        """✅ CORRIGIDO: Conexão SSH via proxy com melhor tratamento de socket"""
        proxy_client = None
        proxy_channel = None
        ssh_client = None
        try:
            proxy = self.get_active_proxy(acesso.cliente)
            logger.info(f"🔗 SSH via proxy: {proxy.nome}")
            self.send(text_data=json.dumps({
                'type': 'info',
                'message': f'⚡ IP privado. SSH via proxy {proxy.nome}...'
            }))
            # 1. ✅ PASSO 1: Conectar ao proxy COM keep-alive
            logger.info(f"📡 Conectando ao proxy {proxy.host}:{proxy.porta}")
            proxy_client = paramiko.SSHClient()
            proxy_client.set_missing_host_key_policy(paramiko.AutoAddPolicy())
            proxy_client.connect(
                hostname=proxy.host,
                port=proxy.porta,
                username=proxy.usuario,
                password=proxy.senha,
                timeout=15,
                look_for_keys=False,
                allow_agent=False,
                banner_timeout=15
            )
            # ✅ Configurar keep-alive no proxy
            proxy_transport = proxy_client.get_transport()
            if proxy_transport:
                proxy_transport.set_keepalive(30)
            logger.info("✅ Conectado ao proxy")
            # 2. ✅ PASSO 2: Criar tunelamento
            logger.info(f"🔀 Criando túnel para {host}:{port}")
            dest_addr = (host, port)
            local_addr = ('127.0.0.1', 0)
            proxy_channel = proxy_transport.open_channel(
                "direct-tcpip",
                dest_addr,
                local_addr,
                timeout=15
            )
            if not proxy_channel:
                raise Exception("Falha ao criar canal direto-tcpip")
            logger.info("✅ Túnel criado")
            # 3. ✅ PASSO 3: Conectar ao host final ATRAVÉS do proxy_channel
            logger.info(f"🔐 Conectando ao host {host}:{port} via túnel")
            ssh_client = paramiko.SSHClient()
            ssh_client.set_missing_host_key_policy(paramiko.AutoAddPolicy())
            # ✅ IMPORTANTE: Use sock parameter com o proxy_channel
            ssh_client.connect(
                hostname=host,
                port=port,
                username=username,
                password=password,
                sock=proxy_channel,
                timeout=15,
                look_for_keys=False,
                allow_agent=False,
                banner_timeout=15
            )
            # ✅ Configurar keep-alive na conexão final
            ssh_transport = ssh_client.get_transport()
            if ssh_transport:
                ssh_transport.set_keepalive(30)
            logger.info("✅ Autenticado no host remoto")
            # 4. ✅ PASSO 4: Abrir shell
            channel = ssh_client.open_session()
            channel.get_pty()
            channel.invoke_shell()
            self.channel = channel
            # ✅ NOVO: Configurar timeout e non-blocking
            self.channel.settimeout(0.5)
            logger.info("✅ Shell aberto")
            # ✅ IMPORTANTE: Armazenar referências
            self.ssh_client = ssh_client
            self.proxy_client = proxy_client
            self.proxy_channel = proxy_channel
            self.send(text_data=json.dumps({
                'type': 'connected',
                'message': f'✓ SSH a {host}:{port} via {proxy.nome}'
            }))
            # 5. ✅ PASSO 5: Iniciar leitura
            self.read_thread = threading.Thread(target=self.read_ssh_output, daemon=True)
            self.read_thread.start()
        except Exception as e:
            logger.error(f"❌ SSH via proxy: {str(e)}", exc_info=True)
            self.send(text_data=json.dumps({
                'type': 'error',
                'message': f'Erro SSH via proxy: {str(e)}'
            }))
            # ✅ Limpeza apropriada em caso de erro
            if ssh_client:
                try:
                    ssh_client.close()
                except:
                    pass
            if proxy_channel:
                try:
                    proxy_channel.close()
                except:
                    pass
            if proxy_client:
                try:
                    proxy_client.close()
                except:
                    pass
    # ============================================================
    # TELNET - DIRECT
    # ============================================================
    def connect_telnet(self, host, port, username, password):
        """Conexão Telnet direta (IP público)"""
        try:
            logger.info(f"🔗 Telnet: Conectando a {host}:{port}")
            self.telnet_client = telnetlib.Telnet(host, port, timeout=10)
            logger.info(f"✅ Telnet: Conectado")
            self.send(text_data=json.dumps({
                'type': 'info',
                'message': f'Conectando Telnet a {host}:{port}...'
            }))
            self.authenticate_telnet(username, password)
            self.send(text_data=json.dumps({
                'type': 'connected',
                'message': f'✓ Conectado Telnet a {host}:{port}'
            }))
            self.read_thread = threading.Thread(target=self.read_telnet_output, daemon=True)
            self.read_thread.start()
        except Exception as e:
            logger.error(f"❌ Telnet: Erro ao conectar: {str(e)}")
            self.send(text_data=json.dumps({
                'type': 'error',
                'message': f'Erro Telnet: {str(e)}'
            }))
    def authenticate_telnet(self, username, password):
        """Autenticar em Telnet com suporte a diferentes prompts"""
        try:
            logger.info(f"🔐 Telnet: Iniciando autenticação para {username}")
            logger.info("📤 Enviando ENTER inicial...")
            self.telnet_client.write(b'\n')
            time.sleep(0.5)
            output = self.telnet_client.read_very_eager()
            if output:
                self.send(text_data=json.dumps({
                    'type': 'output',
                    'data': output.decode('utf-8', errors='ignore')
                }))
                logger.info(f"📨 Banner: {output[:100]}")
            logger.info("⏳ Aguardando prompt de username/login...")
            output = b''
            timeout_count = 0
            max_timeout = 50
            while timeout_count < max_timeout:
                try:
                    chunk = self.telnet_client.read_very_eager()
                    if chunk:
                        output += chunk
                        logger.debug(f"📨 Recebido: {chunk[:100]}")
                        lower_output = output.lower()
                        if any(x in lower_output for x in [b'username', b'login', b'user', b'Login:', b'Username:']):
                            logger.info("✅ Prompt de login encontrado")
                            break
                    else:
                        timeout_count += 1
                        time.sleep(0.1)
                except EOFError:
                    logger.error("❌ Conexão fechada ao aguardar username")
                    raise Exception("Conexão Telnet fechada")
            if output:
                self.send(text_data=json.dumps({
                    'type': 'output',
                    'data': output.decode('utf-8', errors='ignore')
                }))
            logger.info(f"📤 Enviando username: {username}")
            self.telnet_client.write(username.encode('utf-8') + b'\n')
            time.sleep(0.5)
            output = self.telnet_client.read_very_eager()
            if output:
                self.send(text_data=json.dumps({
                    'type': 'output',
                    'data': output.decode('utf-8', errors='ignore')
                }))
            logger.info("⏳ Aguardando prompt de senha...")
            output = b''
            timeout_count = 0
            max_timeout = 50
            while timeout_count < max_timeout:
                try:
                    chunk = self.telnet_client.read_very_eager()
                    if chunk:
                        output += chunk
                        logger.debug(f"📨 Recebido: {chunk[:100]}")
                        lower_output = output.lower()
                        if any(x in lower_output for x in [b'password', b'password:', b'passwd', b'senha']):
                            logger.info("✅ Prompt de senha encontrado")
                            break
                    else:
                        timeout_count += 1
                        time.sleep(0.1)
                except EOFError:
                    logger.error("❌ Conexão fechada ao aguardar password")
                    raise Exception("Conexão Telnet fechada")
            if output:
                self.send(text_data=json.dumps({
                    'type': 'output',
                    'data': output.decode('utf-8', errors='ignore')
                }))
            logger.info("📤 Enviando senha")
            self.telnet_client.write(password.encode('utf-8') + b'\n')
            time.sleep(0.5)
            output = self.telnet_client.read_very_eager()
            if output:
                self.send(text_data=json.dumps({
                    'type': 'output',
                    'data': output.decode('utf-8', errors='ignore')
                }))
            logger.info("⏳ Aguardando prompt do shell...")
            time.sleep(1)
            output = self.telnet_client.read_very_eager()
            if output:
                self.send(text_data=json.dumps({
                    'type': 'output',
                    'data': output.decode('utf-8', errors='ignore')
                }))
            logger.info(f"✅ Telnet: Autenticado com sucesso como {username}")
        except Exception as e:
            logger.error(f"❌ Telnet: Erro na autenticação: {str(e)}")
            self.send(text_data=json.dumps({
                'type': 'error',
                'message': f'Erro na autenticação Telnet: {str(e)}'
            }))
            raise
    # ============================================================
    # TELNET - VIA PROXY
    # ============================================================
    def connect_telnet_via_proxy(self, acesso, host, port, username, password):
        """Conexão Telnet via proxy"""
        proxy_client = None
        proxy_channel = None
        try:
            proxy = self.get_active_proxy(acesso.cliente)
            logger.info(f"🔗 Telnet via proxy: {proxy.nome}")
            self.send(text_data=json.dumps({
                'type': 'info',
                'message': f'⚡ IP privado. Telnet via proxy {proxy.nome}...'
            }))
            proxy_client = paramiko.SSHClient()
            proxy_client.set_missing_host_key_policy(paramiko.AutoAddPolicy())
            proxy_client.connect(
                hostname=proxy.host,
                port=proxy.porta,
                username=proxy.usuario,
                password=proxy.senha,
                timeout=15,
                look_for_keys=False,
                allow_agent=False,
                banner_timeout=15
            )
            proxy_transport = proxy_client.get_transport()
            if proxy_transport:
                proxy_transport.set_keepalive(30)
            dest_addr = (host, port)
            local_addr = ('127.0.0.1', 0)
            proxy_channel = proxy_transport.open_channel(
                "direct-tcpip",
                dest_addr,
                local_addr,
                timeout=15
            )
            if not proxy_channel:
                raise Exception("Falha ao criar canal direto-tcpip")
            self.telnet_client = telnetlib.Telnet()
            self.telnet_client.sock = proxy_channel
            logger.info(f"✅ Telnet via proxy: Conectado")
            self.send(text_data=json.dumps({
                'type': 'info',
                'message': f'Autenticando Telnet...'
            }))
            self.authenticate_telnet(username, password)
            self.proxy_client = proxy_client
            self.proxy_channel = proxy_channel
            self.send(text_data=json.dumps({
                'type': 'connected',
                'message': f'✓ Telnet a {host}:{port} via {proxy.nome}'
            }))
            self.read_thread = threading.Thread(target=self.read_telnet_output, daemon=True)
            self.read_thread.start()
        except Exception as e:
            logger.error(f"❌ Telnet via proxy: {str(e)}", exc_info=True)
            self.send(text_data=json.dumps({
                'type': 'error',
                'message': f'Erro Telnet via proxy: {str(e)}'
            }))
            if proxy_channel:
                try:
                    proxy_channel.close()
                except:
                    pass
            if proxy_client:
                try:
                    proxy_client.close()
                except:
                    pass
    # ============================================================
    # LEITURA - SSH (CORRIGIDO)
    # ============================================================
    def read_ssh_output(self):
        """✅ CORRIGIDO: Thread para ler output SSH com melhor tratamento"""
        try:
            while not self.stop_reading:
                try:
                    if self.channel and self.channel.recv_ready():
                        try:
                            output = self.channel.recv(4096)
                            if output:
                                decoded = output.decode('utf-8', errors='ignore')
                                self.send(text_data=json.dumps({
                                    'type': 'output',
                                    'data': decoded
                                }))
                        except socket.timeout:
                            pass
                    if self.channel and self.channel.exit_status_ready():
                        logger.info("SSH: Canal fechado")
                        break
                    time.sleep(0.01)  # ✅ Pequeno delay para não sobrecarregar
                except Exception as e:
                    logger.error(f"SSH: Erro na leitura: {str(e)}", exc_info=True)
                    break
        except Exception as e:
            logger.error(f"SSH: Erro fatal na thread de leitura: {str(e)}", exc_info=True)
            self.send(text_data=json.dumps({
                'type': 'error',
                'message': f'Erro na leitura SSH: {str(e)}'
            }))
    # ============================================================
    # LEITURA - TELNET (CORRIGIDO)
    # ============================================================
    def read_telnet_output(self):
        """✅ CORRIGIDO: Thread para ler output Telnet com melhor tratamento"""
        try:
            while not self.stop_reading:
                try:
                    output = self.telnet_client.read_very_eager()
                    if output:
                        decoded = output.decode('utf-8', errors='ignore')
                        self.send(text_data=json.dumps({
                            'type': 'output',
                            'data': decoded
                        }))
                    time.sleep(0.05)  # ✅ Pequeno delay
                except EOFError:
                    logger.info("Telnet: Conexão encerrada")
                    break
                except socket.timeout:
                    pass
                except Exception as e:
                    logger.error(f"Telnet: Erro na leitura: {str(e)}")
                    break
        except Exception as e:
            logger.error(f"Telnet: Erro fatal na thread de leitura: {str(e)}", exc_info=True)
            self.send(text_data=json.dumps({
                'type': 'error',
                'message': f'Erro na leitura Telnet: {str(e)}'
            }))