#!/bin/sh
# Rotas isoladas de uma instância OpenVPN dedicada do CRM (server-crm-N).
# Instalado em /usr/local/sbin/crm-ovpn-rotas (root:root 0755) e executado
# pelo unit crm-ovpn-rotas@server-crm-N.service (deploy/openvpn/), que sobe
# junto com openvpn-server@server-crm-N.
#
# Não é script `up` do OpenVPN de propósito: o unit openvpn-server@ tem
# LimitNPROC=10 e, neste servidor (container LXC), o root conta nesse
# limite — o OpenVPN não consegue nem fazer fork para rodar o script.
#
# Isola as redes de cada cliente numa tabela de rotas PRÓPRIA do túnel
# (1000+N), em vez da tabela principal do servidor:
#   - a tabela main não tem nenhuma rede de cliente: o tráfego do próprio CRM
#     (APIs, Hermes, internet) nunca entra em VPN de cliente por acaso;
#   - só usa a tabela N o tráfego que sai com o IP do servidor neste túnel
#     como origem (ip rule from <ip do túnel>) — o CRM faz esse bind quando
#     conecta num equipamento DESTE cliente (clientes/vpn_rota.py);
#   - dois clientes podem declarar a mesma faixa (10.0.0.0/8 etc.) sem
#     colidir, cada um na sua tabela.
#
# As redes vêm de /etc/openvpn/server/server-crm-N.rotas (um CIDR por linha),
# gravado pelo CRM (www-data). Como esse arquivo não é de root, cada linha é
# validada antes de virar argumento do `ip`.
set -u

INSTANCIA="${1:-}"
case "$INSTANCIA" in
    server-crm-[0-9]*) ;;
    *) echo "crm-ovpn-rotas: instância inválida '$INSTANCIA'" >&2; exit 1 ;;
esac
N="${INSTANCIA#server-crm-}"
case "$N" in *[!0-9]*|'') echo "crm-ovpn-rotas: N inválido" >&2; exit 1 ;; esac
DEV="tun-crm-${N}"
TABELA=$((1000 + N))
ROTAS="/etc/openvpn/server/${INSTANCIA}.rotas"

# O OpenVPN (Type=notify) só avisa "pronto" depois de configurar a tun, mas
# espera um pouco por garantia.
i=0
while [ $i -lt 20 ]; do
    ORIGEM=$(ip -4 -o addr show dev "$DEV" 2>/dev/null | awk '{split($4, a, "/"); print a[1]; exit}')
    [ -n "$ORIGEM" ] && break
    sleep 0.5
    i=$((i + 1))
done
if [ -z "${ORIGEM:-}" ]; then
    echo "crm-ovpn-rotas: $DEV sem endereço IPv4" >&2
    exit 1
fi

# Regra de origem: idempotente (remove as anteriores desta tabela antes).
while ip -4 rule del lookup "$TABELA" 2>/dev/null; do :; done
ip -4 rule add from "$ORIGEM" lookup "$TABELA" pref "$TABELA"

ip -4 route flush table "$TABELA" 2>/dev/null
# Sub-rede do próprio túnel (o /29) e bloqueio do resto: tráfego com origem
# no túnel só vai para as redes deste cliente, nunca cai na tabela main.
SUBNET=$(ip -4 route show dev "$DEV" proto kernel scope link | awk 'NR==1{print $1}')
[ -n "$SUBNET" ] && ip -4 route replace "$SUBNET" dev "$DEV" table "$TABELA"
ip -4 route replace unreachable default table "$TABELA"

if [ -f "$ROTAS" ]; then
    while IFS= read -r cidr || [ -n "$cidr" ]; do
        cidr=$(printf '%s' "$cidr" | tr -d ' \r\t')
        [ -z "$cidr" ] && continue
        case "$cidr" in
            *[!0-9./]*) echo "crm-ovpn-rotas: ignorando '$cidr'" >&2; continue ;;
        esac
        ip -4 route replace "$cidr" dev "$DEV" table "$TABELA" \
            || echo "crm-ovpn-rotas: falha ao instalar $cidr" >&2
    done < "$ROTAS"
fi
echo "crm-ovpn-rotas: $INSTANCIA → tabela $TABELA (origem $ORIGEM)"
exit 0
